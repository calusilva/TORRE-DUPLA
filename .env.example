DATABASE_URL="postgresql://usuario:password@localhost:5432/gs_erp_demo"
# Gerar com: openssl rand -base64 32
AUTH_SECRET="alterar-para-um-segredo-aleatorio"
NEXTAUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST=true

# Opcional — para upload de fotos de não conformidades
UPLOAD_DIR="/tmp/gs-erp-uploads"
MAX_FILE_SIZE=5242880

# Conteúdo do QR Code das etiquetas:
#   json (omissão) — payload JSON da especificação (código, OF, obra, cliente, zona, dimensões, material, url)
#   url            — URL absoluto da ficha de rastreabilidade (abre directamente na câmara do telemóvel)
QR_CONTEUDO=url
APP_URL="http://localhost:3000"
